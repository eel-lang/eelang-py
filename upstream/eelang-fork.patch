diff --git a/Objects/exceptions.c b/Objects/exceptions.c
index f262a1a52ab..73db3eda054 100644
--- a/Objects/exceptions.c
+++ b/Objects/exceptions.c
@@ -3044,6 +3044,12 @@ ComplexExtendsException(PyExc_LookupError, KeyError, BaseException,
 SimpleExtendsException(PyExc_Exception, ValueError,
                        "Inappropriate argument value (of correct type).");
 
+/*
+ *    MatchError extends ValueError
+ */
+SimpleExtendsException(PyExc_ValueError, MatchError,
+                       "Pattern match failed; no case matched.");
+
 /*
  *    UnicodeError extends ValueError
  */
@@ -4473,6 +4479,7 @@ static struct static_exception static_exceptions[] = {
     ITEM(RecursionError),  // base: RuntimeError(Exception)
     ITEM(UnboundLocalError), // base: NameError(Exception)
     ITEM(UnicodeError),  // base: ValueError(Exception)
+    ITEM(MatchError),  // base: ValueError(Exception)
 
     // Level 5: ConnectionError(OSError) subclasses
