diff --git a/Grammar/python.gram b/Grammar/python.gram
index 18b968d027d..57b7b2f991f 100644
--- a/Grammar/python.gram
+++ b/Grammar/python.gram
@@ -142,6 +142,7 @@ compound_stmt[stmt_ty]:
     | &('for' | 'async') for_stmt
     | &'try' try_stmt
     | &'while' while_stmt
+    | pipeline_stmt
     | match_stmt
 
 # SIMPLE STATEMENTS
@@ -546,6 +547,21 @@ match_assign_as_target[expr_ty]:
     | !"_" name=NAME !('.' | '(') &'=' {
         _PyPegen_set_expr_context(p, name, Store) }
 
+# eelang: пайплайны. Блочная форма (под `name =`) — через INDENT/DEDENT,
+# inline — через `a ..f(...)` / `a ..f: expr` в primary.
+pipeline_stmt[stmt_ty]:
+    | a=NAME '=' NEWLINE INDENT b=star_expression NEWLINE s=pipe_line* DEDENT {
+        _PyPegen_pipeline_stmt(p, a, b, s, EXTRA) }
+    | a=NAME '=' b=star_expression NEWLINE INDENT s=pipe_line+ DEDENT {
+        _PyPegen_pipeline_stmt(p, a, b, s, EXTRA) }
+
+pipe_line[void*]: s=pipe_step NEWLINE { s }
+
+pipe_step[void*]:
+    | '.' '.' f=NAME '(' a=[arguments] ')' { _PyPegen_pipe_step_call(p, f, a, EXTRA) }
+    | '.' '.' f=NAME ':' b=expression { _PyPegen_pipe_step_block(p, f, b, EXTRA) }
+    | '.' f=NAME '(' a=[arguments] ')' { _PyPegen_pipe_step_method(p, f, a, EXTRA) }
+
 or_pattern[pattern_ty]:
     | patterns[asdl_pattern_seq*]='|'.closed_pattern+ {
