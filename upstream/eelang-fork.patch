From d643b4b19d636e246589d5d1b708243ca9dd44b0 Mon Sep 17 00:00:00 2001
From: pwtail <abvit89s@gmail.com>
Date: Tue, 13 Oct 2026 17:20:18 +0300
Subject: [PATCH 03/10] Add eelang v3 regression tests

---
 Lib/test/test_eelang_v3.py | 232 +++++++++++++++++++++++++++++++++++++
 1 file changed, 232 insertions(+)
 create mode 100644 Lib/test/test_eelang_v3.py

diff --git a/Lib/test/test_eelang_v3.py b/Lib/test/test_eelang_v3.py
new file mode 100644
index 00000000000..568193b132d
--- /dev/null
+++ b/Lib/test/test_eelang_v3.py
@@ -0,0 +1,232 @@
+"""Tests for eelang v3: assert-patterns, match def, and pipelines.
+
+eelang is a pure superset of CPython 3.15: all new syntax is currently
+invalid in stock CPython, so no feature gate is needed.
+"""
+
+import subprocess
+import sys
+import unittest
+
+
+class MatchErrorTests(unittest.TestCase):
+    def test_subclass(self):
+        self.assertTrue(issubclass(MatchError, ValueError))
+
+    def test_message(self):
+        with self.assertRaises(MatchError) as cm:
+            raise MatchError("no match")
+        self.assertEqual(cm.exception.args, ("no match",))
+
+
+class AssertPatternTests(unittest.TestCase):
+    def test_capture(self):
+        ns = {}
+        exec("x = 5\nassert x = 5\n", ns)
+        self.assertEqual(ns["x"], 5)
+
+    def test_wildcard(self):
+        exec("assert _ = 42\n", {})
+
+    def test_literal(self):
+        exec("x = 5\nassert 5 = x\n", {})
+
+    def test_sequence(self):
+        ns = {}
+        exec("assert (x, y) = (1, 2)\n", ns)
+        self.assertEqual((ns["x"], ns["y"]), (1, 2))
+
+    def test_class_pattern(self):
+        ns = {}
+        exec("""
+from dataclasses import dataclass
+@dataclass
+class P:
+    x: int
+    y: int
+p = P(3, 4)
+assert P(x, y) = p
+""", ns)
+        self.assertEqual((ns["x"], ns["y"]), (3, 4))
+
+    def test_multiple_bindings(self):
+        ns = {}
+        exec("a = 1\nb = 2\nassert 1 = a, 2 = b if a < b\n", ns)
+        self.assertEqual((ns["a"], ns["b"]), (1, 2))
+
+    def test_failure_raises_matcherror(self):
+        with self.assertRaises(MatchError):
+            exec("x = 6\nassert 5 = x\n", {})
+
+    def test_failure_args_are_subject(self):
+        with self.assertRaises(MatchError) as cm:
+            exec("x = 6\nassert 5 = x\n", {})
+        self.assertEqual(cm.exception.args, (6,))
+
+    def test_guard_failure(self):
+        with self.assertRaises(MatchError):
+            exec("x = 5\nassert x = 5 if x > 10\n", {})
+
+    def test_subject_evaluated_once(self):
+        ns = {}
+        exec("""
+log = []
+def f():
+    log.append('f')
+    return 6
+try:
+    assert 5 = f()
+except MatchError:
+    pass
+""", ns)
+        self.assertEqual(len(ns["log"]), 1)
+
+    def test_plain_assert_intact(self):
+        with self.assertRaises(AssertionError):
+            exec("assert 1 == 2, 'msg'\n", {})
+
+    def test_survives_optimize(self):
+        code = "x = 6\nassert 5 = x\n"
+        proc = subprocess.run(
+            [sys.executable, "-O", "-c", code],
+            capture_output=True, text=True,
+        )
+        self.assertNotEqual(proc.returncode, 0)
+        self.assertIn("MatchError", proc.stderr)
+
+
+class MatchDefTests(unittest.TestCase):
+    def test_recursion(self):
+        ns = {}
+        exec("""
+match def fib(n: int):
+    case 0 = n:
+        return 0
+    case 1 = n:
+        return 1
+    case _ = n:
+        return fib(n - 1) + fib(n - 2)
+""", ns)
+        self.assertEqual(ns["fib"](10), 55)
+
+    def test_guard_and_else(self):
+        ns = {}
+        exec("""
+match def f(p):
+    "docstring."
+    case (x, y) = p if x > y:
+        return 'below'
+    else:
+        return 'other'
+""", ns)
+        self.assertEqual(ns["f"]((5, 3)), "below")
+        self.assertEqual(ns["f"]((2, 9)), "other")
+        self.assertEqual(ns["f"].__doc__, "docstring.")
+
+    def test_no_else_raises_matcherror(self):
+        ns = {}
+        exec("""
+match def f(x: int):
+    case 1 = x:
+        return 'one'
+""", ns)
+        with self.assertRaises(MatchError):
+            ns["f"](99)
+
+    def test_defaults_rejected(self):
+        with self.assertRaises(SyntaxError):
+            compile("match def g(x=1):\n    case 1 = x:\n        return 'one'\n",
+                    "<test>", "exec")
+
+    def test_self_must_be_named(self):
+        ns = {}
+        exec("""
+class Shape:
+    match def describe(self, p):
+        case (x, y) = p if x > y:
+            return 'below'
+        case (x, y) = p:
+            return 'other'
+""", ns)
+        self.assertEqual(ns["Shape"]().describe((3, 2)), "below")
+
+
+class PipelineTests(unittest.TestCase):
+    def test_inline_call(self):
+        ns = {}
+        exec("x = [1,2,3] ..len()\n", ns)
+        self.assertEqual(ns["x"], 3)
+
+    def test_inline_call_args(self):
+        ns = {}
+        exec("def add(a, b): return a + b\nx = 10 ..add(5)\n", ns)
+        self.assertEqual(ns["x"], 15)
+
+    def test_inline_block(self):
+        ns = {}
+        exec("def mul(a, b): return a * b\nx = 3 ..mul: 4\n", ns)
+        self.assertEqual(ns["x"], 12)
+
+    def test_inline_chain(self):
+        ns = {}
+        exec("""
+def f(x): return x + 1
+def g(x): return x * 2
+x = 5 ..f() ..g()
+""", ns)
+        self.assertEqual(ns["x"], 12)
+
+    def test_block_form(self):
+        ns = {}
+        exec("""
+def square(x): return x * x
+def is_even(x): return x % 2 == 0
+value =
+    [1, 2, 3, 4, 5]
+    ..map(square)
+    ..filter(is_even)
+""", ns)
+        self.assertEqual(list(ns["value"]), [4, 16])
+
+    def test_block_same_line(self):
+        ns = {}
+        exec("""
+def f(x): return x * 2
+value = [1, 2, 3]
+    ..map(f)
+""", ns)
+        self.assertEqual(list(ns["value"]), [2, 4, 6])
+
+    def test_block_form_block_expr(self):
+        ns = {}
+        exec("""
+value =
+    [1, 2, 3]
+    ..map: lambda n: n * 10
+    ..filter: lambda n: n > 10
+""", ns)
+        self.assertEqual(list(ns["value"]), [20, 30])
+
+    def test_method_chain(self):
+        ns = {}
+        exec("""
+value =
+    [3, 1, 2]
+    .sort()
+""", ns)
+        self.assertIsNone(ns["value"])
+
+    def test_keyword_args(self):
+        ns = {}
+        exec("def f(a, b): return a + b\nx = 1 ..f(b=2)\n", ns)
+        self.assertEqual(ns["x"], 3)
+
+    def test_value_as_last_argument(self):
+        # v ..f(a, b) == f(a, b, v)
+        ns = {}
+        exec("def f(a, b, c): return (a, b, c)\nx = 3 ..f(1, 2)\n", ns)
+        self.assertEqual(ns["x"], (1, 2, 3))
+
+
+if __name__ == "__main__":
+    unittest.main()
-- 
