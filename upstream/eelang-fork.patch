From 1fdf9e9ca9df7350e4a0185bda14f595de054fca Mon Sep 17 00:00:00 2001
From: pwtail <abvit89s@gmail.com>
Date: Wed, 14 Oct 2026 02:24:55 +0300
Subject: [PATCH 09/10] Support arbitrary pipeline targets and improve
 assert-pattern errors

- Accept any assignment target on the left of a block pipeline (obj.attr =,
  d[0] =, a, b =, head, *rest =) by switching pipeline_stmt from NAME to
  star_targets.
- Add an invalid_assert_stmt clause so 'assert x = 1, "msg"' reports that
  assert-patterns take no trailing message instead of the misleading
  "cannot assign to name here".
---
 Grammar/python.gram        |  14 +-
 Lib/test/test_eelang_v3.py |  27 +++
 Parser/parser.c            | 430 ++++++++++++++++++++-----------------
 3 files changed, 269 insertions(+), 202 deletions(-)

diff --git a/Grammar/python.gram b/Grammar/python.gram
index c3e20d39393..a16741171f9 100644
--- a/Grammar/python.gram
+++ b/Grammar/python.gram
@@ -526,8 +526,11 @@ match_binding[match_assign_binding*]:
     | a=match_binding_pattern '=' b=expression {
         _PyPegen_match_binding(p, a, b, EXTRA) }
 
-# eelang: верхний уровень биндинга разрешает '=' после capture/value (case x = e:);
-# вложенные паттерны остаются с обычными guard'ами.
+# eelang: на верхнем уровне биндинга разрешён '=' после capture/value
+# (case x = e:, case Color.RED = e:). Стоковые capture_pattern/value_pattern это
+# запрещают (в pattern_capture_target и value_pattern стоит !'='), поэтому нужны
+# отдельные match_assign_as_target и attr-альтернативы; литералы, sequence,
+# class- и wildcard-паттерны покрывает обычный `pattern`.
 match_binding_pattern[pattern_ty]:
     | a=pattern { a }
     | target=match_assign_as_target { _PyAST_MatchAs(NULL, target->v.Name.id, EXTRA) }
@@ -552,9 +555,9 @@ match_assign_as_target[expr_ty]:
 # eelang: пайплайны. Блочная форма (под `name =`) — через INDENT/DEDENT,
 # inline — через `a ..f(...)` / `a ..f: expr` в primary.
 pipeline_stmt[asdl_stmt_seq*]:
-    | a=NAME '=' NEWLINE INDENT b=star_expression NEWLINE s=pipe_step* DEDENT {
+    | a=star_targets '=' NEWLINE INDENT b=star_expression NEWLINE s=pipe_step* DEDENT {
         _PyPegen_pipeline_stmt(p, a, b, s, EXTRA) }
-    | a=NAME '=' b=star_expression NEWLINE INDENT s=pipe_step+ DEDENT {
+    | a=star_targets '=' b=star_expression NEWLINE INDENT s=pipe_step+ DEDENT {
         _PyPegen_pipeline_stmt(p, a, b, s, EXTRA) }
 
 pipe_step[void*]:
@@ -1385,6 +1388,9 @@ invalid_del_stmt:
     | 'del' a=star_expressions {
         RAISE_SYNTAX_ERROR_INVALID_TARGET(DEL_TARGETS, a) }
 invalid_assert_stmt:
+    | 'assert' a=','.match_binding+ ',' b=expression {
+        RAISE_SYNTAX_ERROR_KNOWN_LOCATION(
+            b, "assert-pattern does not support a trailing message; use a plain assert for the message form") }
     | 'assert' a=expression '=' b=expression {
         RAISE_SYNTAX_ERROR_KNOWN_RANGE(
             a, b,
diff --git a/Lib/test/test_eelang_v3.py b/Lib/test/test_eelang_v3.py
index 6dcfb8a0cd0..2d9b58b63f1 100644
--- a/Lib/test/test_eelang_v3.py
+++ b/Lib/test/test_eelang_v3.py
@@ -391,6 +391,33 @@ def f():
         self.assertNotIn("v", ns)
         self.assertNotIn("x", ns)
 
+    def test_block_form_arbitrary_targets(self):
+        # Блочная форма работает с любым assignment-таргетом (attr/subscript/unpack).
+        ns = {}
+        exec("""
+class O: pass
+obj = O()
+obj.attr =
+    [1, 2, 3]
+    ..len()
+d = {}
+d[0] =
+    [1, 2, 3]
+    ..len()
+a, b =
+    [10, 20]
+    ..map(lambda x: x + 1)
+    ..list()
+head, *rest =
+    [1, 2, 3, 4]
+    ..map(lambda x: x * 10)
+    ..list()
+""", ns)
+        self.assertEqual(ns["obj"].attr, 3)
+        self.assertEqual(ns["d"][0], 3)
+        self.assertEqual((ns["a"], ns["b"]), (11, 21))
+        self.assertEqual((ns["head"], ns["rest"]), (10, [20, 30, 40]))
+
 
 if __name__ == "__main__":
     unittest.main()
