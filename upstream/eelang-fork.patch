diff --git a/Parser/action_helpers.c b/Parser/action_helpers.c
index 94d2a0a65dd..14c179929be 100644
--- a/Parser/action_helpers.c
+++ b/Parser/action_helpers.c
@@ -2132,3 +2132,312 @@ _PyPegen_register_stmts(Parser *p, asdl_stmt_seq* stmts) {
     p->last_stmt_location.end_col_offset = last_stmt->end_col_offset;
     return stmts;
 }
+
+/* ================== eelang v3: assert-patterns and match def ================== */
+
+static location
+match_assign_loc(Py_ssize_t lineno, Py_ssize_t col_offset,
+                 Py_ssize_t end_lineno, Py_ssize_t end_col_offset)
+{
+    location loc;
+    loc.lineno = lineno;
+    loc.col_offset = col_offset;
+    loc.end_lineno = end_lineno;
+    loc.end_col_offset = end_col_offset;
+    return loc;
+}
+
+match_assign_binding *
+_PyPegen_match_binding(Parser *p, pattern_ty pattern, expr_ty subject,
+                       Py_ssize_t lineno, Py_ssize_t col_offset,
+                       Py_ssize_t end_lineno, Py_ssize_t end_col_offset,
+                       PyArena *arena)
+{
+    match_assign_binding *b = PyMem_Malloc(sizeof(match_assign_binding));
+    if (b == NULL) {
+        return (match_assign_binding *)PyErr_NoMemory();
+    }
+    b->pattern = pattern;
+    b->subject = subject;
+    return b;
+}
+
+match_assign_case *
+_PyPegen_match_bindings(Parser *p, asdl_seq *bindings, expr_ty guard,
+                        Py_ssize_t lineno, Py_ssize_t col_offset,
+                        Py_ssize_t end_lineno, Py_ssize_t end_col_offset,
+                        PyArena *arena)
+{
+    Py_ssize_t n = asdl_seq_LEN(bindings);
+    asdl_pattern_seq *patterns = _Py_asdl_pattern_seq_new(n, arena);
+    asdl_expr_seq *subjects = _Py_asdl_expr_seq_new(n, arena);
+    if (patterns == NULL || subjects == NULL) {
+        return NULL;
+    }
+    for (Py_ssize_t i = 0; i < n; i++) {
+        match_assign_binding *b = (match_assign_binding *)asdl_seq_GET_UNTYPED(bindings, i);
+        asdl_seq_SET(patterns, i, b->pattern);
+        asdl_seq_SET(subjects, i, b->subject);
+    }
+    match_assign_case *mc = PyMem_Malloc(sizeof(match_assign_case));
+    if (mc == NULL) {
+        return (match_assign_case *)PyErr_NoMemory();
+    }
+    mc->patterns = patterns;
+    mc->subjects = subjects;
+    mc->guard = guard;
+    mc->body = NULL;
+    mc->loc = match_assign_loc(lineno, col_offset, end_lineno, end_col_offset);
+    return mc;
+}
+
+match_assign_case *
+_PyPegen_match_assign_case(Parser *p, match_assign_case *mc, asdl_stmt_seq *body,
+                           Py_ssize_t lineno, Py_ssize_t col_offset,
+                           Py_ssize_t end_lineno, Py_ssize_t end_col_offset,
+                           PyArena *arena)
+{
+    if (mc == NULL) {
+        return NULL;
+    }
+    mc->body = body;
+    mc->loc = match_assign_loc(lineno, col_offset, end_lineno, end_col_offset);
+    return mc;
+}
+
+static expr_ty
+match_assign_subject(Parser *p, match_assign_case *mc)
+{
+    if (asdl_seq_LEN(mc->subjects) == 1) {
+        return asdl_seq_GET(mc->subjects, 0);
+    }
+    return _PyAST_Tuple(mc->subjects, Load, mc->loc.lineno, mc->loc.col_offset,
+                        mc->loc.end_lineno, mc->loc.end_col_offset, p->arena);
+}
+
+static pattern_ty
+match_assign_pattern(Parser *p, match_assign_case *mc)
+{
+    if (asdl_seq_LEN(mc->patterns) == 1) {
+        return asdl_seq_GET(mc->patterns, 0);
+    }
+    return _PyAST_MatchSequence(mc->patterns, mc->loc.lineno, mc->loc.col_offset,
+                                mc->loc.end_lineno, mc->loc.end_col_offset, p->arena);
+}
+
+static pattern_ty
+match_assign_wildcard(Parser *p, match_assign_case *mc)
+{
+    return _PyAST_MatchAs(NULL, NULL, mc->loc.lineno, mc->loc.col_offset,
+                          mc->loc.end_lineno, mc->loc.end_col_offset, p->arena);
+}
+
+/* A top-level bare capture or wildcard always matches; anything else (or a
+   guarded pattern) can fail and needs the raise case. */
+static int
+match_assign_irrefutable(pattern_ty pat, expr_ty guard)
+{
+    return guard == NULL && pat->kind == MatchAs_kind && pat->v.MatchAs.pattern == NULL;
+}
+
+/* Build `raise MatchError(subject)`. */
+static stmt_ty
+match_assign_raise(Parser *p, expr_ty subject, location loc)
+{
+    expr_ty fn = _PyAST_Name(&_Py_ID(MatchError), Load, loc.lineno, loc.col_offset,
+                             loc.end_lineno, loc.end_col_offset, p->arena);
+    asdl_expr_seq *args = _Py_asdl_expr_seq_new(1, p->arena);
+    if (fn == NULL || args == NULL) {
+        return NULL;
+    }
+    asdl_seq_SET(args, 0, subject);
+    expr_ty call = _PyAST_Call(fn, args, NULL, loc.lineno, loc.col_offset,
+                               loc.end_lineno, loc.end_col_offset, p->arena);
+    if (call == NULL) {
+        return NULL;
+    }
+    return _PyAST_Raise(call, NULL, loc.lineno, loc.col_offset,
+                        loc.end_lineno, loc.end_col_offset, p->arena);
+}
+
+/* Chain the cases of a match def into nested matches; the last case falls
+   into the else body or, without one, into `raise MatchError(subject)`. */
+stmt_ty
+_PyPegen_match_assign_block(Parser *p, asdl_seq *cases, asdl_stmt_seq *else_body,
+                            Py_ssize_t lineno, Py_ssize_t col_offset,
+                            Py_ssize_t end_lineno, Py_ssize_t end_col_offset,
+                            PyArena *arena)
+{
+    Py_ssize_t n = asdl_seq_LEN(cases);
+    stmt_ty inner = NULL;
+    for (Py_ssize_t i = n - 1; i >= 0; i--) {
+        match_assign_case *mc = (match_assign_case *)asdl_seq_GET_UNTYPED(cases, i);
+        expr_ty subject = match_assign_subject(p, mc);
+        pattern_ty pat = match_assign_pattern(p, mc);
+        if (subject == NULL || pat == NULL) {
+            return NULL;
+        }
+        /* The last case needs no fallthrough when it is an unguarded,
+           irrefutable pattern; a raise fallthrough there would be unreachable
+           (codegen rejects it). */
+        int need_fallthrough = (i != n - 1) ||
+            else_body != NULL ||
+            !match_assign_irrefutable(pat, mc->guard);
+        asdl_match_case_seq *mcases = _Py_asdl_match_case_seq_new(need_fallthrough ? 2 : 1, p->arena);
+        if (mcases == NULL) {
+            return NULL;
+        }
+        asdl_seq_SET(mcases, 0, _PyAST_match_case(pat, mc->guard, mc->body, p->arena));
+        if (need_fallthrough) {
+            asdl_stmt_seq *fallthrough;
+            if (i != n - 1) {
+                fallthrough = _Py_asdl_stmt_seq_new(1, p->arena);
+                if (fallthrough == NULL) {
+                    return NULL;
+                }
+                asdl_seq_SET(fallthrough, 0, inner);
+            }
+            else {
+                fallthrough = else_body;
+                if (fallthrough == NULL) {
+                    stmt_ty raise_stmt = match_assign_raise(p, subject, mc->loc);
+                    if (raise_stmt == NULL) {
+                        return NULL;
+                    }
+                    fallthrough = _Py_asdl_stmt_seq_new(1, p->arena);
+                    if (fallthrough == NULL) {
+                        return NULL;
+                    }
+                    asdl_seq_SET(fallthrough, 0, raise_stmt);
+                }
+            }
+            asdl_seq_SET(mcases, 1,
+                         _PyAST_match_case(match_assign_wildcard(p, mc), NULL,
+                                           fallthrough, p->arena));
+        }
+        inner = _PyAST_Match(subject, mcases, mc->loc.lineno, mc->loc.col_offset,
+                             mc->loc.end_lineno, mc->loc.end_col_offset, p->arena);
+        if (inner == NULL) {
+            return NULL;
+        }
+    }
+    return inner;
+}
+
+/* `assert P1 = e1, P2 = e2 if g` desugars to:
+     match (.N := (e1, e2)):
+         case (P1, P2) if g: pass
+         case _: raise MatchError(.N)
+   The leading-dot temp name cannot collide with user code and the subject is
+   evaluated exactly once. Because it desugars to `match`, -O does not strip it
+   (unlike a plain `assert`). */
+stmt_ty
+_PyPegen_assert_pattern(Parser *p, match_assign_case *mc,
+                        Py_ssize_t lineno, Py_ssize_t col_offset,
+                        Py_ssize_t end_lineno, Py_ssize_t end_col_offset,
+                        PyArena *arena)
+{
+    if (mc == NULL) {
+        return NULL;
+    }
+    location loc = match_assign_loc(lineno, col_offset, end_lineno, end_col_offset);
+    PyObject *tmpname = PyUnicode_FromFormat(".%zd", p->n_assert_tmps++);
+    if (tmpname == NULL) {
+        return NULL;
+    }
+    /* Identifiers must be interned; interned strings are immortal, so the
+       borrowed refs in the AST Name nodes stay valid after the DECREF. */
+    PyUnicode_InternInPlace(&tmpname);
+    if (tmpname == NULL) {
+        return NULL;
+    }
+    expr_ty subject = match_assign_subject(p, mc);
+    pattern_ty pat = match_assign_pattern(p, mc);
+    if (subject == NULL || pat == NULL) {
+        Py_DECREF(tmpname);
+        return NULL;
+    }
+    expr_ty tmp_store = _PyAST_Name(tmpname, Store, loc.lineno, loc.col_offset,
+                                    loc.end_lineno, loc.end_col_offset, p->arena);
+    expr_ty tmp_load = _PyAST_Name(tmpname, Load, loc.lineno, loc.col_offset,
+                                   loc.end_lineno, loc.end_col_offset, p->arena);
+    Py_DECREF(tmpname);
+    if (tmp_store == NULL || tmp_load == NULL) {
+        return NULL;
+    }
+    expr_ty walrus = _PyAST_NamedExpr(tmp_store, subject, loc.lineno, loc.col_offset,
+                                      loc.end_lineno, loc.end_col_offset, p->arena);
+    asdl_stmt_seq *pass_body = _Py_asdl_stmt_seq_new(1, p->arena);
+    if (walrus == NULL || pass_body == NULL) {
+        return NULL;
+    }
+    asdl_seq_SET(pass_body, 0, _PyAST_Pass(loc.lineno, loc.col_offset,
+                                           loc.end_lineno, loc.end_col_offset, p->arena));
+    asdl_match_case_seq *cases;
+    int irrefutable = match_assign_irrefutable(pat, mc->guard);
+    if (irrefutable) {
+        cases = _Py_asdl_match_case_seq_new(1, p->arena);
+    }
+    else {
+        cases = _Py_asdl_match_case_seq_new(2, p->arena);
+    }
+    if (cases == NULL) {
+        return NULL;
+    }
+    asdl_seq_SET(cases, 0, _PyAST_match_case(pat, mc->guard, pass_body, p->arena));
+    if (!irrefutable) {
+        stmt_ty raise_stmt = match_assign_raise(p, tmp_load, loc);
+        if (raise_stmt == NULL) {
+            return NULL;
+        }
+        asdl_stmt_seq *raise_body = _Py_asdl_stmt_seq_new(1, p->arena);
+        if (raise_body == NULL) {
+            return NULL;
+        }
+        asdl_seq_SET(raise_body, 0, raise_stmt);
+        asdl_seq_SET(cases, 1, _PyAST_match_case(match_assign_wildcard(p, mc), NULL,
+                                                 raise_body, p->arena));
+    }
+    return _PyAST_Match(walrus, cases, loc.lineno, loc.col_offset,
+                        loc.end_lineno, loc.end_col_offset, p->arena);
+}
+
+stmt_ty
+_PyPegen_match_def(Parser *p, expr_ty name, asdl_type_param_seq *type_params,
+                   arguments_ty params, expr_ty returns, stmt_ty docstring,
+                   asdl_seq *cases, asdl_stmt_seq *else_body,
+                   Py_ssize_t lineno, Py_ssize_t col_offset,
+                   Py_ssize_t end_lineno, Py_ssize_t end_col_offset,
+                   PyArena *arena)
+{
+    if (params != NULL &&
+        (asdl_seq_LEN(params->defaults) || asdl_seq_LEN(params->kwonlyargs) ||
+         params->vararg || params->kwarg)) {
+        RAISE_ERROR_KNOWN_LOCATION(
+            p, PyExc_SyntaxError, lineno, col_offset, end_lineno, end_col_offset,
+            "match def does not support default arguments, keyword-only arguments or *args/**kwargs");
+        return NULL;
+    }
+    stmt_ty inner = _PyPegen_match_assign_block(p, cases, else_body, lineno,
+                                                col_offset, end_lineno,
+                                                end_col_offset, arena);
+    if (inner == NULL) {
+        return NULL;
+    }
+    Py_ssize_t nbody = docstring != NULL ? 2 : 1;
+    asdl_stmt_seq *body = _Py_asdl_stmt_seq_new(nbody, arena);
+    if (body == NULL) {
+        return NULL;
+    }
+    if (docstring != NULL) {
+        asdl_seq_SET(body, 0, docstring);
+    }
+    asdl_seq_SET(body, nbody - 1, inner);
+    arguments_ty args = params ? params : _PyPegen_empty_arguments(p);
+    if (args == NULL) {
+        return NULL;
+    }
+    return _PyAST_FunctionDef(name->v.Name.id, args, body, NULL, returns, NULL,
+                              type_params, lineno, col_offset, end_lineno,
+                              end_col_offset, arena);
+}
