     | a=primary '.' b=NAME { _PyAST_Attribute(a, b->v.Name.id, Load, EXTRA) }
+    | a=primary '.' '.' f=NAME '(' b=[arguments] ')' { _PyPegen_pipe_call(p, a, f, b, EXTRA) }
+    | a=primary '.' '.' f=NAME ':' b=expression { _PyPegen_pipe_block(p, a, f, b, EXTRA) }
     | a=primary b=genexp { _PyAST_Call(a, CHECK(asdl_expr_seq*, (asdl_expr_seq*)_PyPegen_singleton_seq(p, b)), NULL, EXTRA) }
     | a=primary '(' b=[arguments] ')' {
         _PyAST_Call(a,
diff --git a/Parser/action_helpers.c b/Parser/action_helpers.c
index 14c179929be..5be437f90a6 100644
--- a/Parser/action_helpers.c
+++ b/Parser/action_helpers.c
@@ -2441,3 +2441,164 @@ _PyPegen_match_def(Parser *p, expr_ty name, asdl_type_param_seq *type_params,
                               type_params, lineno, col_offset, end_lineno,
                               end_col_offset, arena);
 }
+
+/* ===================== eelang v3: pipelines ===================== */
+
+#define EEL_PIPE_CALL 0
+#define EEL_PIPE_BLOCK 1
+#define EEL_PIPE_METHOD 2
+
+static expr_ty
+pipe_apply(Parser *p, expr_ty value, eelang_pipe_step *step, PyArena *arena)
+{
+    if (value == NULL || step == NULL) {
+        return NULL;
+    }
+    if (step->kind == EEL_PIPE_BLOCK) {
+        /* `v ..f: e`  =>  f(e, v) */
+        asdl_expr_seq *args = _Py_asdl_expr_seq_new(2, arena);
+        if (args == NULL) {
+            return NULL;
+        }
+        asdl_seq_SET(args, 0, step->block);
+        asdl_seq_SET(args, 1, value);
+        return _PyAST_Call(step->func, args, NULL, step->loc.lineno,
+                           step->loc.col_offset, step->loc.end_lineno,
+                           step->loc.end_col_offset, arena);
+    }
+    if (step->kind == EEL_PIPE_CALL) {
+        /* `v ..f(args)`  =>  f(args..., v)  (value last) */
+        asdl_expr_seq *old = step->call ? step->call->v.Call.args : NULL;
+        asdl_keyword_seq *kw = step->call ? step->call->v.Call.keywords : NULL;
+        Py_ssize_t n = old ? asdl_seq_LEN(old) : 0;
+        asdl_expr_seq *args = _Py_asdl_expr_seq_new(n + 1, arena);
+        if (args == NULL) {
+            return NULL;
+        }
+        for (Py_ssize_t i = 0; i < n; i++) {
+            asdl_seq_SET(args, i, asdl_seq_GET(old, i));
+        }
+        asdl_seq_SET(args, n, value);
+        return _PyAST_Call(step->func, args, kw, step->loc.lineno,
+                           step->loc.col_offset, step->loc.end_lineno,
+                           step->loc.end_col_offset, arena);
+    }
+    /* EEL_PIPE_METHOD: `v .m(args)`  =>  v.m(args) */
+    expr_ty attr = _PyAST_Attribute(value, step->func->v.Name.id, Load,
+                                    step->loc.lineno, step->loc.col_offset,
+                                    step->loc.end_lineno, step->loc.end_col_offset,
+                                    arena);
+    if (attr == NULL) {
+        return NULL;
+    }
+    asdl_expr_seq *args = step->call ? step->call->v.Call.args : NULL;
+    asdl_keyword_seq *kw = step->call ? step->call->v.Call.keywords : NULL;
+    return _PyAST_Call(attr, args, kw, step->loc.lineno, step->loc.col_offset,
+                       step->loc.end_lineno, step->loc.end_col_offset, arena);
+}
+
+static eelang_pipe_step *
+pipe_step_new(Parser *p, int kind, expr_ty func, expr_ty call, expr_ty block,
+              Py_ssize_t lineno, Py_ssize_t col_offset,
+              Py_ssize_t end_lineno, Py_ssize_t end_col_offset, PyArena *arena)
+{
+    eelang_pipe_step *step = PyMem_Malloc(sizeof(eelang_pipe_step));
+    if (step == NULL) {
+        PyErr_NoMemory();
+        return NULL;
+    }
+    step->kind = kind;
+    step->func = func;
+    step->call = call;
+    step->block = block;
+    step->loc = match_assign_loc(lineno, col_offset, end_lineno, end_col_offset);
+    return step;
+}
+
+void *
+_PyPegen_pipe_step_call(Parser *p, expr_ty func, expr_ty call,
+                        Py_ssize_t lineno, Py_ssize_t col_offset,
+                        Py_ssize_t end_lineno, Py_ssize_t end_col_offset,
+                        PyArena *arena)
+{
+    return pipe_step_new(p, EEL_PIPE_CALL, func, call, NULL, lineno, col_offset,
+                         end_lineno, end_col_offset, arena);
+}
+
+void *
+_PyPegen_pipe_step_block(Parser *p, expr_ty func, expr_ty block,
+                         Py_ssize_t lineno, Py_ssize_t col_offset,
+                         Py_ssize_t end_lineno, Py_ssize_t end_col_offset,
+                         PyArena *arena)
+{
+    return pipe_step_new(p, EEL_PIPE_BLOCK, func, NULL, block, lineno, col_offset,
+                         end_lineno, end_col_offset, arena);
+}
+
+void *
+_PyPegen_pipe_step_method(Parser *p, expr_ty func, expr_ty call,
+                          Py_ssize_t lineno, Py_ssize_t col_offset,
+                          Py_ssize_t end_lineno, Py_ssize_t end_col_offset,
+                          PyArena *arena)
+{
+    return pipe_step_new(p, EEL_PIPE_METHOD, func, call, NULL, lineno, col_offset,
+                         end_lineno, end_col_offset, arena);
+}
+
+expr_ty
+_PyPegen_pipe_call(Parser *p, expr_ty value, expr_ty func, expr_ty call,
+                   Py_ssize_t lineno, Py_ssize_t col_offset,
+                   Py_ssize_t end_lineno, Py_ssize_t end_col_offset,
+                   PyArena *arena)
+{
+    eelang_pipe_step *step = pipe_step_new(p, EEL_PIPE_CALL, func, call, NULL,
+                                           lineno, col_offset, end_lineno,
+                                           end_col_offset, arena);
+    if (step == NULL) {
+        return NULL;
+    }
+    return pipe_apply(p, value, step, arena);
+}
+
+expr_ty
+_PyPegen_pipe_block(Parser *p, expr_ty value, expr_ty func, expr_ty block,
+                    Py_ssize_t lineno, Py_ssize_t col_offset,
+                    Py_ssize_t end_lineno, Py_ssize_t end_col_offset,
+                    PyArena *arena)
+{
+    eelang_pipe_step *step = pipe_step_new(p, EEL_PIPE_BLOCK, func, NULL, block,
+                                           lineno, col_offset, end_lineno,
+                                           end_col_offset, arena);
+    if (step == NULL) {
+        return NULL;
+    }
+    return pipe_apply(p, value, step, arena);
+}
+
+stmt_ty
+_PyPegen_pipeline_stmt(Parser *p, expr_ty target, expr_ty value, asdl_seq *steps,
+                       Py_ssize_t lineno, Py_ssize_t col_offset,
+                       Py_ssize_t end_lineno, Py_ssize_t end_col_offset,
+                       PyArena *arena)
+{
+    expr_ty folded = value;
+    Py_ssize_t n = steps ? asdl_seq_LEN(steps) : 0;
+    for (Py_ssize_t i = 0; i < n; i++) {
+        eelang_pipe_step *step = (eelang_pipe_step *)asdl_seq_GET_UNTYPED(steps, i);
+        folded = pipe_apply(p, folded, step, arena);
+        if (folded == NULL) {
+            return NULL;
+        }
+    }
+    target = _PyPegen_set_expr_context(p, target, Store);
+    if (target == NULL) {
+        return NULL;
+    }
+    asdl_expr_seq *targets = _Py_asdl_expr_seq_new(1, arena);
+    if (targets == NULL) {
+        return NULL;
+    }
+    asdl_seq_SET(targets, 0, target);
+    return _PyAST_Assign(targets, folded, NULL, lineno, col_offset, end_lineno,
+                         end_col_offset, arena);
+}
