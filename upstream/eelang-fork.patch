diff --git a/Lib/test/test_syntax.py b/Lib/test/test_syntax.py
index f381bb3c117..12ffe4b7b78 100644
--- a/Lib/test/test_syntax.py
+++ b/Lib/test/test_syntax.py
@@ -2811,17 +2811,13 @@ def f(x: *b)
     Traceback (most recent call last):
     SyntaxError: cannot assign to literal here. Maybe you meant '==' instead of '='?
 
-    >>> assert 1 = 2
-    Traceback (most recent call last):
-    SyntaxError: cannot assign to literal here. Maybe you meant '==' instead of '='?
+    # eelang: `assert 1 = 2` is now a valid pattern-assert (raises MatchError).
 
     >>> assert (1 = 2)
     Traceback (most recent call last):
     SyntaxError: cannot assign to literal here. Maybe you meant '==' instead of '='?
 
-    >>> assert 'a' = a
-    Traceback (most recent call last):
-    SyntaxError: cannot assign to literal here. Maybe you meant '==' instead of '='?
+    # eelang: `assert 'a' = a` is now a valid pattern-assert (raises MatchError).
 
     >>> assert x[0] = 1
     Traceback (most recent call last):
@@ -2831,17 +2827,13 @@ def f(x: *b)
     Traceback (most recent call last):
     SyntaxError: cannot assign to yield expression here. Maybe you meant '==' instead of '='?
 
-    >>> assert a = 2
-    Traceback (most recent call last):
-    SyntaxError: cannot assign to name here. Maybe you meant '==' instead of '='?
+    # eelang: `assert a = 2` is now a valid pattern-assert (binds a).
 
     >>> assert (a = 2)
     Traceback (most recent call last):
     SyntaxError: invalid syntax. Maybe you meant '==' or ':=' instead of '='?
 
-    >>> assert a = b
-    Traceback (most recent call last):
-    SyntaxError: cannot assign to name here. Maybe you meant '==' instead of '='?
+    # eelang: `assert a = b` is now a valid pattern-assert (binds a).
 
     >>> assert 1, 1 = b
     Traceback (most recent call last):
@@ -2859,9 +2851,7 @@ def f(x: *b)
     Traceback (most recent call last):
     SyntaxError: invalid syntax. Maybe you meant '==' or ':=' instead of '='?
 
-    >>> assert 1 = a, a = 1
-    Traceback (most recent call last):
-    SyntaxError: cannot assign to literal here. Maybe you meant '==' instead of '='?
