From 4b2ff6df6b6bea11a2d9b3d97ef1a64ebf616604 Mon Sep 17 00:00:00 2001
From: pwtail <abvit89s@gmail.com>
Date: Tue, 13 Oct 2026 16:49:25 +0300
Subject: [PATCH 01/10] Add MatchError, assert-patterns and match def to the v3
 tree

---
 Grammar/python.gram                           |   31 +
 .../pycore_global_objects_fini_generated.h    |    1 +
 Include/internal/pycore_global_strings.h      |    1 +
 .../internal/pycore_runtime_init_generated.h  |    1 +
 .../internal/pycore_unicodeobject_generated.h |    4 +
 Include/pyerrors.h                            |    1 +
 Lib/test/exception_hierarchy.txt              |    1 +
 Objects/exceptions.c                          |    7 +
 Parser/action_helpers.c                       |  309 ++
 Parser/parser.c                               | 4735 ++++++++++-------
 Parser/pegen.c                                |    1 +
 Parser/pegen.h                                |   28 +
 Tools/build/generate_global_objects.py        |    3 +
 13 files changed, 3208 insertions(+), 1915 deletions(-)

diff --git a/Grammar/python.gram b/Grammar/python.gram
index 4408d69d9a0..18b968d027d 100644
--- a/Grammar/python.gram
+++ b/Grammar/python.gram
@@ -214,6 +214,7 @@ yield_stmt[stmt_ty]: y=yield_expr { _PyAST_Expr(y, EXTRA) }
 
 assert_stmt[stmt_ty]:
     | invalid_assert_stmt
+    | 'assert' b=match_bindings { _PyPegen_assert_pattern(p, b, EXTRA) }
     | 'assert' a=expression b=[',' z=expression { z }] { _PyAST_Assert(a, b, EXTRA) }
 
 import_stmt[stmt_ty](memo):
@@ -487,6 +488,9 @@ finally_block[asdl_stmt_seq*]:
 match_stmt[stmt_ty]:
     | "match" subject=subject_expr ':' NEWLINE INDENT cases[asdl_match_case_seq*]=case_block+ DEDENT {
         CHECK_VERSION(stmt_ty, 10, "Pattern matching is", _PyAST_Match(subject, cases, EXTRA)) }
+    | "match" 'def' n=NAME t=[type_params] '(' params=[params] ')' a=['->' z=expression { z }] ':' NEWLINE INDENT d=[a=strings NEWLINE { _PyAST_Expr(a, EXTRA) }] cases=match_assign_case_block+ b=[else_block] DEDENT {
+        CHECK_VERSION(stmt_ty, 10, "Pattern matching is",
+            _PyPegen_match_def(p, n, t, params, a, d, cases, b, EXTRA)) }
     | invalid_match_stmt
 
 subject_expr[expr_ty]:
@@ -506,6 +510,26 @@ patterns[pattern_ty]:
         _PyAST_MatchSequence(patterns, EXTRA) }
     | pattern
 
+# eelang: case-биндинги для assert-паттернов и match def.
+match_assign_case_block[match_assign_case*]:
+    | "case" b=match_bindings ':' body=block {
+        _PyPegen_match_assign_case(p, b, body, EXTRA) }
+
+match_bindings[match_assign_case*]:
+    | a[asdl_seq*]=','.match_binding+ g=['if' e=named_expression { e }] {
+        _PyPegen_match_bindings(p, a, g, EXTRA) }
+
+match_binding[match_assign_binding*]:
+    | a=match_binding_pattern '=' b=expression {
+        _PyPegen_match_binding(p, a, b, EXTRA) }
+
+# eelang: верхний уровень биндинга разрешает '=' после capture/value (case x = e:);
+# вложенные паттерны остаются с обычными guard'ами.
+match_binding_pattern[pattern_ty]:
+    | a=pattern { a }
+    | target=match_assign_as_target { _PyAST_MatchAs(NULL, target->v.Name.id, EXTRA) }
+    | a=attr !('.' | '(') { _PyAST_MatchValue(a, EXTRA) }
+
 pattern[pattern_ty]:
     | as_pattern
     | or_pattern
@@ -513,8 +537,15 @@ pattern[pattern_ty]:
 as_pattern[pattern_ty]:
     | pattern=or_pattern 'as' target=pattern_capture_target {
         _PyAST_MatchAs(pattern, target->v.Name.id, EXTRA) }
+    | pattern=or_pattern 'as' target=match_assign_as_target {
+        _PyAST_MatchAs(pattern, target->v.Name.id, EXTRA) }
     | invalid_as_pattern
 
+# eelang: 'as'-цель в биндинге заканчивается '=' (case P as q = e:).
+match_assign_as_target[expr_ty]:
+    | !"_" name=NAME !('.' | '(') &'=' {
+        _PyPegen_set_expr_context(p, name, Store) }
+
 or_pattern[pattern_ty]:
     | patterns[asdl_pattern_seq*]='|'.closed_pattern+ {
         asdl_seq_LEN(patterns) == 1 ? asdl_seq_GET(patterns, 0) : _PyAST_MatchOr(patterns, EXTRA) }
