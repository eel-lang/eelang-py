From 1fad2afbb471472f38b7a9a9ab8f26c38c3a62aa Mon Sep 17 00:00:00 2001
From: pwtail <abvit89s@gmail.com>
Date: Wed, 14 Oct 2026 11:24:43 +0300
Subject: [PATCH 10/10] Allow inline ..assert: pipeline steps and reject inline
 ..match:

- pipe_step now accepts '..assert: PATTERN' on one line in addition to the
  block form, so e.g. '..assert: {'k': val}' works.
- Inline '..match:' is rejected by a new invalid_pipe_step rule with an
  actionable SyntaxError (the body needs a block of case clauses).
---
 Grammar/python.gram        |    7 +
 Lib/test/test_eelang_v3.py |   20 +
 Parser/parser.c            | 1383 ++++++++++++++++++++----------------
 3 files changed, 781 insertions(+), 629 deletions(-)

diff --git a/Grammar/python.gram b/Grammar/python.gram
index a16741171f9..68b588ff3e3 100644
--- a/Grammar/python.gram
+++ b/Grammar/python.gram
@@ -563,10 +563,17 @@ pipeline_stmt[asdl_stmt_seq*]:
 pipe_step[void*]:
     | '.' '.' "match" ':' NEWLINE INDENT a=pipe_match_case+ DEDENT { _PyPegen_pipe_step_match(p, a, EXTRA) }
     | '.' '.' 'assert' ':' NEWLINE INDENT a=pattern NEWLINE DEDENT { _PyPegen_pipe_step_assert(p, a, EXTRA) }
+    | '.' '.' 'assert' ':' a=pattern NEWLINE { _PyPegen_pipe_step_assert(p, a, EXTRA) }
     | '.' '.' f=NAME '(' a=[arguments] ')' NEWLINE { _PyPegen_pipe_step_call(p, f, a, EXTRA) }
     | '.' '.' f=NAME ':' NEWLINE INDENT b=expression NEWLINE DEDENT { _PyPegen_pipe_step_block(p, f, b, EXTRA) }
     | '.' '.' f=NAME ':' b=expression NEWLINE { _PyPegen_pipe_step_block(p, f, b, EXTRA) }
     | '.' f=NAME '(' a=[arguments] ')' NEWLINE { _PyPegen_pipe_step_method(p, f, a, EXTRA) }
+    | invalid_pipe_step
+
+# eelang: inline-форма ..match: запрещена — тело требует блока 'case'-ов.
+invalid_pipe_step:
+    | '.' '.' "match" ':' !NEWLINE {
+        RAISE_SYNTAX_ERROR("..match: requires an indented block of 'case' clauses (inline form is not supported)") }
 
 pipe_match_case[void*]:
     | "case" a=pattern g=[guard] ':' e=expression NEWLINE {
diff --git a/Lib/test/test_eelang_v3.py b/Lib/test/test_eelang_v3.py
index 2d9b58b63f1..cb4d2b9b69f 100644
--- a/Lib/test/test_eelang_v3.py
+++ b/Lib/test/test_eelang_v3.py
@@ -372,6 +372,26 @@ class Point:
         Point(x, y)
 """, {})
 
+    def test_assert_step_inline(self):
+        ns = {}
+        exec("""
+v =
+    {'k': 'a'}
+    ..assert: {'k': val}
+""", ns)
+        self.assertEqual(ns["v"], {"k": "a"})
+        self.assertEqual(ns["val"], "a")
+
+    def test_assert_step_inline_failure_raises_matcherror(self):
+        with self.assertRaises(MatchError):
+            exec("v =\n    {'k': 'a'}\n    ..assert: {'k': 'b'}\n", {})
+
+    def test_match_step_inline_rejected(self):
+        # inline-форма ..match: запрещена — тело требует блока case'ов.
+        with self.assertRaises(SyntaxError) as cm:
+            compile("v =\n    5\n    ..match: case 1: 'one'\n", "<t>", "exec")
+        self.assertIn("indented block", cm.exception.msg)
+
     def test_steps_local_scope_in_function(self):
         ns = {}
         exec("""
